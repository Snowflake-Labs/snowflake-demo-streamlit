# Copy to .env.local and fill in. Never commit .env.local.
# OIDC WIF: identity is carried in the JWT, so there is no SNOWFLAKE_USER here.
# Map the token's issuer/subject to a Snowflake user (see repo README).

SNOWFLAKE_ACCOUNT_URL=https://myorg-myacct.snowflakecomputing.com
SNOWFLAKE_WIF_TOKEN=replace-with-your-oidc-jwt
SNOWFLAKE_ROLE=embed_minter
STREAMLIT_APP=STREAMLIT_APPS.PUBLIC.MY_APP
PARENT_ORIGIN=https://your-domain.com
